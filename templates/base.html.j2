<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<meta name="description" content="Claim-by-claim, source-cited fact checks of the {{ show_name }} podcast.">
<link rel="stylesheet" href="{{ root }}static/style.css">
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="{{ root }}index.html">{{ site_title }}</a>
    <nav><a href="{{ root }}index.html">Episodes</a><a href="{{ root }}methodology.html">Methodology</a></nav>
  </div>
</header>
<main class="wrap">
{% block content %}{% endblock %}
</main>
<footer class="wrap site-footer">
  <p>Checks are generated by an AI model with web search and may contain errors. Every verdict links to its sources so you can check them yourself.
  {% if corrections_url %}<a href="{{ corrections_url }}">Report a correction</a>.{% endif %}</p>
  <p>Not affiliated with the podcast. Short quotes are used for commentary; listen to the full episode for context.</p>
</footer>
{% block scripts %}{% endblock %}
</body>
</html>
